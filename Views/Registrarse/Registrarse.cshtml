@model SDSP1.Models.RegistrarViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrarse</title>
    <link rel="stylesheet" href="~/css/Registrarse.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Registrarse</span>
                </div>

                @if (ViewData.ModelState.ContainsKey("") && ViewData.ModelState[""].Errors.Any())
                {
                    <div class="error-general">@ViewData.ModelState[""].Errors[0].ErrorMessage</div>
                }

                <form asp-controller="Registrarse" asp-action="Registrarse" method="post">

                    <div class="input-group input-group--column">
                        <div class="input-row">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="nombre" placeholder="Nombre" />
                        </div>
                        <span asp-validation-for="nombre" class="error-campo"></span>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                            <input asp-for="celular" placeholder="XXXX-XXXX"/>
                        </div>
                        <span asp-validation-for="celular" class="error-campo"></span>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row">
                            <i class="fa-regular fa-envelope"></i>
                            <input asp-for="correo" placeholder="Correo electrónico" />
                        </div>
                        <span asp-validation-for="correo" class="error-campo"></span>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row input-row--relative">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="contraseña" id="inputContraseña" type="password" placeholder="Contraseña" value="@Model?.contraseña" />
                            <span id="toggleContraseña">Mostrar</span>
                        </div>
                        <span asp-validation-for="contraseña" class="error-campo"></span>
                        <div class="medidor-fuerza">
                            <div id="barraFuerza">
                                <div class="segmento"></div>
                                <div class="segmento"></div>
                                <div class="segmento"></div>
                            </div>
                            <span id="textoFuerza" class="texto-fuerza"></span>
                        </div>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row input-row--relative">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="confirmarContraseña" id="inputConfirmar" type="password" placeholder="Confirmar contraseña" value="@Model?.confirmarContraseña" />
                            <span id="toggleConfirmar">Mostrar</span>
                        </div>
                        <span asp-validation-for="confirmarContraseña" class="error-campo"></span>
                    </div>

                    <div class="form-footer">
                        <a href="/Login/Index" class="forgot-link">¿Ya tienes cuenta?</a>
                        <button type="submit" class="login-btn">Crear cuenta</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
    <script src="~/js/Registrarse.js"></script>
</body>
</html>
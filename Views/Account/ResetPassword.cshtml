@model SDSP1.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restablecer contraseña</title>
    <link rel="stylesheet" href="~/css/ForgotPassword.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Restablecer contraseña</span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    var tieneErrorGeneral = ViewData.ModelState.ContainsKey("") &&
                                            ViewData.ModelState[""].Errors.Any();
                    <div class="error-general">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @if (tieneErrorGeneral)
                        {
                            <span>@ViewData.ModelState[""].Errors[0].ErrorMessage</span>
                        }
                        else
                        {
                            <span>Por favor completa todos los campos.</span>
                        }
                    </div>
                }

                <div class="info-general">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Ingresa el código de recuperación y tu nueva contraseña.</span>
                </div>

                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <!-- Código de recuperación -->
                    <div class="input-group">
                        <i class="fa-solid fa-key"></i>
                        <input asp-for="Codigo" 
                               id="inputCodigo" 
                               type="text" 
                               placeholder="Código de recuperación (6 dígitos)" 
                               maxlength="6"
                               pattern="[0-9]{6}" />
                    </div>

                    @if (ViewData.ModelState.ContainsKey("Codigo") && 
                         ViewData.ModelState["Codigo"].Errors.Any())
                    {
                        <div class="error-campo">
                            <i class="fa-solid fa-exclamation-circle"></i>
                            <span>@ViewData.ModelState["Codigo"].Errors[0].ErrorMessage</span>
                        </div>
                    }

                    <!-- Nueva contraseña -->
                    <div class="input-group">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" 
                               id="inputContraseña" 
                               type="password" 
                               placeholder="Nueva contraseña" />
                        <span id="toggleContraseña" class="toggle-password">Mostrar</span>
                    </div>

                    @if (ViewData.ModelState.ContainsKey("Password") && 
                         ViewData.ModelState["Password"].Errors.Any())
                    {
                        <div class="error-campo">
                            <i class="fa-solid fa-exclamation-circle"></i>
                            <span>@ViewData.ModelState["Password"].Errors[0].ErrorMessage</span>
                        </div>
                    }

                    <!-- Confirmar contraseña -->
                    <div class="input-group">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="ConfirmPassword" 
                               id="inputConfirmar" 
                               type="password" 
                               placeholder="Confirmar contraseña" />
                        <span id="toggleConfirmar" class="toggle-password">Mostrar</span>
                    </div>

                    @if (ViewData.ModelState.ContainsKey("ConfirmPassword") && 
                         ViewData.ModelState["ConfirmPassword"].Errors.Any())
                    {
                        <div class="error-campo">
                            <i class="fa-solid fa-exclamation-circle"></i>
                            <span>@ViewData.ModelState["ConfirmPassword"].Errors[0].ErrorMessage</span>
                        </div>
                    }

                    <div class="form-footer">
                        <a href="/Login/Index" class="back-link">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Volver</span>
                        </a>
                        <button type="submit" class="login-btn">Restablecer contraseña</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
    <script src="~/js/ResetPassword.js"></script>
</body>
</html>

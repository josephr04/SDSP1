@model SDSP1.Models.RegistrarViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrarse</title>
    <link rel="stylesheet" href="~/css/Registrarse.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Registrarse</span>
                </div>

                @if (ViewData.ModelState.ContainsKey("") && ViewData.ModelState[""].Errors.Any())
                {
                    <div class="error-general">@ViewData.ModelState[""].Errors[0].ErrorMessage</div>
                }

                <form asp-controller="Registrarse" asp-action="Registrarse" method="post" id="registroForm">
                    <div class="input-group input-group--column">
                        <div class="input-row">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="nombre" placeholder="Nombre" />
                        </div>
                        <span asp-validation-for="nombre" class="error-campo"></span>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row">
                            <i class="fa-regular fa-envelope"></i>
                            <input asp-for="correo" placeholder="Correo electrónico" />
                        </div>
                        <span asp-validation-for="correo" class="error-campo"></span>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row input-row--relative">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="contraseña" id="inputContraseña" type="password" placeholder="Contraseña" value="@Model?.contraseña" />
                            <span id="toggleContraseña">Mostrar</span>
                        </div>
                        <span asp-validation-for="contraseña" class="error-campo"></span>
                        <div class="medidor-fuerza">
                            <div id="barraFuerza">
                                <div class="segmento"></div>
                                <div class="segmento"></div>
                                <div class="segmento"></div>
                            </div>
                            <span id="textoFuerza" class="texto-fuerza"></span>
                        </div>
                    </div>

                    <div class="input-group input-group--column">
                        <div class="input-row input-row--relative">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="confirmarContraseña" id="inputConfirmar" type="password" placeholder="Confirmar contraseña" value="@Model?.confirmarContraseña" />
                            <span id="toggleConfirmar">Mostrar</span>
                        </div>
                        <span asp-validation-for="confirmarContraseña" class="error-campo"></span>
                    </div>

                    <div class="form-footer">
                        <a href="/Login/Index" class="forgot-link">¿Ya tienes cuenta?</a>
                        <button type="submit" class="login-btn" id="btnRegistrar">Crear cuenta</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
    
    <script src="~/js/Registrarse.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // Script para mostrar/ocultar contraseña (si no está en tu Registrarse.js)
        document.getElementById('toggleContraseña')?.addEventListener('click', function() {
            var input = document.getElementById('inputContraseña');
            if (input.type === 'password') {
                input.type = 'text';
                this.textContent = 'Ocultar';
            } else {
                input.type = 'password';
                this.textContent = 'Mostrar';
            }
        });

        document.getElementById('toggleConfirmar')?.addEventListener('click', function() {
            var input = document.getElementById('inputConfirmar');
            if (input.type === 'password') {
                input.type = 'text';
                this.textContent = 'Ocultar';
            } else {
                input.type = 'password';
                this.textContent = 'Mostrar';
            }
        });

        // Script para el spinner al enviar el formulario
        document.getElementById('registroForm')?.addEventListener('submit', function() {
            var btn = document.getElementById('btnRegistrar');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Registrando...';
            }
        });
    </script>
</body>
</html>
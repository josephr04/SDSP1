@model SDSP1.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Olvidé la contraseña</title>
    <link rel="stylesheet" href="~/css/ForgotPassword.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Olvidé la contraseña</span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    var tieneErrorGeneral = ViewData.ModelState.ContainsKey("") &&
                                            ViewData.ModelState[""].Errors.Any();
                    <div class="error-general">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @if (tieneErrorGeneral)
                        {
                            <span>@ViewData.ModelState[""].Errors[0].ErrorMessage</span>
                        }
                        else
                        {
                            <span>Por favor completa todos los campos.</span>
                        }
                    </div>
                }

                <div class="info-general">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Ingresa tu correo electrónico. Te enviaremos un código de recuperación.</span>
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="input-group">
                        <i class="fa-regular fa-envelope"></i>
                        <input asp-for="correo" placeholder="Correo electrónico" />
                    </div>

                    @if (ViewData.ModelState.ContainsKey("correo") && 
                         ViewData.ModelState["correo"].Errors.Any())
                    {
                        <div class="error-campo">
                            <i class="fa-solid fa-exclamation-circle"></i>
                            <span>@ViewData.ModelState["correo"].Errors[0].ErrorMessage</span>
                        </div>
                    }

                    <div class="form-footer">
                        <a href="/Login/Index" class="back-link">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Volver</span>
                        </a>
                        <button type="submit" class="login-btn">Enviar código</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
</body>
</html>

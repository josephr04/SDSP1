@model SDSP1.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="~/css/Login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Login</span>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    var tieneErrorGeneral = ViewData.ModelState.ContainsKey("") &&
                                            ViewData.ModelState[""].Errors.Any();
                    <div class="error-general">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @if (tieneErrorGeneral)
                        {
                            <span> @ViewData.ModelState[""].Errors[0].ErrorMessage</span>
                        }
                        else
                        {
                            <span> Por favor completa todos los campos.</span>
                        }
                    </div>
                }

                <form asp-controller="Login" asp-action="Login" method="post">
                    <div class="input-group">
                        <i class="fa-regular fa-envelope"></i>
                        <input asp-for="correo" placeholder="Correo" />
                    </div>

                    <div class="input-group">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="contraseña" id="inputContraseña" type="password" placeholder="Contraseña" />
                        <span id="toggleContraseña">Mostrar</span>
                    </div>

                    <div class="form-footer">
                        <a href="/Registrarse/Index" class="forgot-link">¿No tienes una cuenta? Regístrate</a>
                        <button type="submit" class="login-btn">Login</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
    <script src="~/js/Login.js"></script>
</body>
</html>
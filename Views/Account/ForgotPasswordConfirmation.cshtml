@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmación enviada</title>
    <link rel="stylesheet" href="~/css/ForgotPassword.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <div class="login-section">
            <div class="form-container">
                <div class="tabs">
                    <span class="tab active">Código enviado</span>
                </div>

                <div class="success-message">
                    <i class="fa-solid fa-check-circle"></i>
                    <h2>¡Código enviado!</h2>
                    <p>Revisa tu correo electrónico. Te hemos enviado un código de 6 dígitos.</p>
                    <p><strong>El código expira en 15 minutos.</strong></p>
                    <p>Si no encuentras el correo, revisa tu carpeta de <strong>Spam</strong></strong>.</p>
                </div>

                <div class="info-general">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Usa el código para restablecer tu contraseña.</span>
                </div>

                <div class="form-footer">
                    <a href="/Account/ResetPassword" class="login-btn">
                        <i class="fa-solid fa-arrow-right"></i>
                        <span>Ingresar código</span>
                    </a>
                </div>

                <div class="form-footer">
                    <a href="/Login/Index" class="back-link">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="image-section">
            <div class="circle-bg"></div>
        </div>
    </div>
</body>
</html>
